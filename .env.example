# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Only needed if a Server Action must bypass RLS.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Google Cloud API key with "Places API (New)" enabled — used to
# read the live Google rating and review count. Never prefix with NEXT_PUBLIC_.
# Without it the site falls back to the rating/count stored in the database.
GOOGLE_PLACES_API_KEY=

# Comma-separated emails allowed into /admin (password or Google sign-in).
# Without this, ANY Google account could sign in once the provider is enabled.
ADMIN_ALLOWED_EMAILS=
